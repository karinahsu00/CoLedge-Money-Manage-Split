FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_PRIVATE_KEY=your_private_key_here
FIREBASE_CLIENT_EMAIL=your_client_email_here
FIREBASE_DATABASE_URL=your_database_url_here
FIREBASE_API_KEY=your_api_key_here

# Optional – defaults to 5002
PORT=5002

# CORS – set at least one of these in production so the server rejects
# requests from non-allowed origins.
#
# Single allowed origin:
# CORS_ORIGIN=https://your-app.vercel.app
#
# Multiple allowed origins (comma-separated):
# CORS_ORIGINS=https://your-app.vercel.app,https://preview.your-app.vercel.app
